# Tokens: generate independently on the final host. NEVER commit actual secrets.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
INTAKE_SERVICE_TOKEN=REPLACE_WITH_RANDOM_TOKEN
# Private on-prem inference only. LLM disabled until model and gateway are actually available.
ENABLE_LLM=false
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_ALLOWED_HOSTS=127.0.0.1,localhost,vllm
LLM_MODEL=Qwen/Qwen3-8B
LLM_API_KEY=REPLACE_WITH_SEPARATE_RANDOM_TOKEN
LLM_TIMEOUT_SECONDS=15
